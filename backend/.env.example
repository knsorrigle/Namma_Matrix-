# Copy to backend/.env and edit. Everything here is optional.

# mock = no model needed (fake but sensible thoughts). openai = any OpenAI-compatible server.
LLM_PROVIDER=mock

# Local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
# GODMODE_MODEL=qwen2.5:7b

# Hosted Groq instead (only for recording review replays):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.1-8b-instant

# Cost controls
MAX_THINKERS=10
BATCH_SIZE=5
IDLE_THINKERS=2
TICK_INTERVAL=3
# Chance per tick that a citizen talks a topic over with a friend (free, no model call)
CHAT_RATE=0.15
